DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Neon via pooler : paramètres recommandés (?pgbouncer=true&connection_limit=5&pool_timeout=20).
# Ne pas créer DIRECT_URL pour l'instant (voir README : requis plus tard pour les migrations via pooler).
JWT_SECRET="change-me-32-chars-minimum-strong-secret"
JWT_EXPIRES_IN="15m"
PORT=4000
FRONTEND_URL="http://localhost:3000"
MAX_FILE_SIZE=10485760
NODE_ENV=development
# Nombre de proxys de confiance (défaut 1)
TRUST_PROXY_HOPS=1
# Durée absolue max d'une session glissante en heures (défaut 8)
SESSION_MAX_HOURS=8
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="mot-de-passe-factice-12-chars-minimum"
# Seed idempotent par défaut (upsert, ne supprime rien).
# Reset destructif (vide TOUTES les tables, objets R2 non supprimés) :
# SEED_RESET="false"
# CONFIRM_WIPE="nom-exact-de-la-base"
# Seed interdit en production sauf ALLOW_SEED=true (destructif : deleteMany)
# ALLOW_SEED="false"

# Stockage R2 (Cloudflare) — requis en production
# STORAGE_DRIVER: r2 (défaut, prod) | local (dev/test uniquement, interdit en prod)
STORAGE_DRIVER="r2"
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# Optionnel si bucket public / dev URL activée
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

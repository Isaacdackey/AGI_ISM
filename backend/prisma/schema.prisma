generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Moteurs explicites : "native" pour le dev local (Windows),
  // "debian-openssl-3.0.x" pour les images Docker (bookworm).
  // Sans ceci, Prisma devine openssl-1.1.x et crash (libssl.so.1.1 absente).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum ResourceType {
  COURS
  TD
  TP
  CONTROLE
  EXAMEN
  DEVOIR
  PROJET
  CORRECTION
  FICHE_REVISION
  ANNALE
  AUTRE
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  tokenVersion Int   @default(0)
  mustChangePassword Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resources Resource[] @relation("UploadedBy")
}

model Campus {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schools     School[]
  resources   Resource[]
}

model School {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?  @default("#C1502E")
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  resources   Resource[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campusId])
  @@index([name])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  code        String?  @unique
  description String?
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resources   Resource[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([name])
}

model Resource {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  type        ResourceType
  status      ResourceStatus @default(PENDING)
  level       String?        // L1, L2, L3, M1, M2
  semester    String?        // S1..S6
  year        Int?
  tags        String[]       @default([])
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  downloadCount Int          @default(0)
  campusId    String
  campus      Campus         @relation(fields: [campusId], references: [id], onDelete: Restrict)
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  uploadedById String?
  uploadedBy   User?         @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([schoolId])
  @@index([subjectId])
  @@index([type])
  @@index([campusId])
  @@index([status, schoolId])
  @@index([status, subjectId])
  @@index([status, type])
  @@index([year])
  @@index([level])
  @@index([createdAt])
  @@index([campusId, schoolId, subjectId])
  // Trigram GIN (recherche `contains` insensible à la casse) — map sur les
  // index créés par la migration 20260911000000_pg_trgm_gin (pas de doublon).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Resource_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Resource_description_trgm_idx")
}
